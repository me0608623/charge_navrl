  [256, N] from checkpoint, the shape in current model is [256, N+3].                       
                                                                                            
  方案 (ii)：擴充第一層權重拷貝（推薦）                                                     
                                                                                            
  原理：將舊權重複製到新網絡，新增維度的權重初始化為 0                                      
                                                                                            
  優點：                                                                                    
  - 保留已學習的特徵提取能力                                                                
  - 新維度初始為 0，不會破壞已有行為                                                        
  - 訓練初期可以快速利用新觀測                                                              
                                                                                            
  實現步驟                                                                                  
                                                                                            
  Step 1: 創建轉換腳本 scripts/tools/expand_checkpoint.py                                   
                                                                                            
  #!/usr/bin/env python3                                                                    
  """擴充 checkpoint 以支持新增觀測維度                                                     
                                                                                            
  使用方法：                                                                                
      python expand_checkpoint.py \                                                         
          --input /path/to/old_model.pt \                                                   
          --output /path/to/expanded_model.pt \                                             
          --old_obs_dim 129 \                                                               
          --new_obs_dim 132 \                                                               
          --new_dims_indices [75, 76, 77]  # 新維度插入位置                                 
  """                                                                                       
  import argparse                                                                           
  import torch                                                                              
                                                                                            
  def expand_checkpoint(input_path, output_path, old_dim, new_dim, new_indices):            
      """擴充 checkpoint 的第一層權重"""                                                    
      checkpoint = torch.load(input_path, map_location='cpu')                               
                                                                                            
      # 獲取模型狀態                                                                        
      if 'model_state_dict' in checkpoint:                                                  
          state_dict = checkpoint['model_state_dict']                                       
      else:                                                                                 
          state_dict = checkpoint                                                           
                                                                                            
      # 需要擴充的層（Actor 和 Critic 的第一層）                                            
      layers_to_expand = [                                                                  
          'actor.0.weight',                                                                 
          'critic.0.weight',                                                                
      ]                                                                                     
                                                                                            
      for layer_name in layers_to_expand:                                                   
          if layer_name not in state_dict:                                                  
              print(f"Warning: {layer_name} not found, skipping")                           
              continue                                                                      
                                                                                            
          old_weight = state_dict[layer_name]  # [out_features, old_dim]                    
          out_features = old_weight.shape[0]                                                
                                                                                            
          # 創建新權重（初始化為 0）                                                        
          new_weight = torch.zeros(out_features, new_dim)                                   
                                                                                            
          # 計算舊維度到新維度的映射                                                        
          old_idx = 0                                                                       
          for new_idx in range(new_dim):                                                    
              if new_idx in new_indices:                                                    
                  # 新增維度，保持 0                                                        
                  pass                                                                      
              else:                                                                         
                  # 舊維度，複製權重                                                        
                  new_weight[:, new_idx] = old_weight[:, old_idx]                           
                  old_idx += 1                                                              
                                                                                            
          state_dict[layer_name] = new_weight                                               
          print(f"Expanded {layer_name}: [{out_features}, {old_dim}] -> [{out_features},    
  {new_dim}]")                                                                              
                                                                                            
      # 保存擴充後的 checkpoint                                                             
      if 'model_state_dict' in checkpoint:                                                  
          checkpoint['model_state_dict'] = state_dict                                       
      else:                                                                                 
          checkpoint = state_dict                                                           
                                                                                            
      torch.save(checkpoint, output_path)                                                   
      print(f"Saved expanded checkpoint to {output_path}")                                  
                                                                                            
  if __name__ == "__main__":                                                                
      parser = argparse.ArgumentParser()                                                    
      parser.add_argument("--input", required=True)                                         
      parser.add_argument("--output", required=True)                                        
      parser.add_argument("--old_obs_dim", type=int, required=True)                         
      parser.add_argument("--new_obs_dim", type=int, required=True)                         
      parser.add_argument("--new_dims_indices", type=str, required=True,                    
                          help="JSON list of indices, e.g. '[75,76,77]'")                   
      args = parser.parse_args()                                                            
                                                                                            
      import json                                                                           
      new_indices = set(json.loads(args.new_dims_indices))                                  
                                                                                            
      expand_checkpoint(args.input, args.output,                                            
                        args.old_obs_dim, args.new_obs_dim, new_indices)                    
                                                                                            
