  如果需要更精細的控制，可以在網絡中加入 adapter 層：                                       
                                                                                            
  class AdapterMLP(nn.Module):                                                              
      """將新觀測映射到與舊觀測相容的空間"""                                                
      def __init__(self, new_obs_dim, old_obs_dim, hidden_dim=64):                          
          super().__init__()                                                                
          self.adapter = nn.Sequential(                                                     
              nn.Linear(new_obs_dim, hidden_dim),                                           
              nn.ELU(),                                                                     
              nn.Linear(hidden_dim, old_obs_dim),                                           
          )                                                                                 
          # 初始化為近似恆等映射（對舊維度）                                                
          nn.init.zeros_(self.adapter[-1].weight)                                           
          nn.init.zeros_(self.adapter[-1].bias)                                             
                                                                                            
      def forward(self, x):                                                                 
          return self.adapter(x)                                                            
                                                                                            
