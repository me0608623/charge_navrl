flowchart LR
  subgraph TRAD["傳統 Explicit MOT pipeline (modular)"]
    direction LR
    t1["LiDAR scan"]:::trad --> t2["Object<br>detection"]:::trad --> t3["Data<br>association"]:::trad --> t4["Kalman filter<br>track state"]:::trad --> t5["Tracks<br>{pos, vel}"]:::trad --> t6["Planner /<br>Policy"]:::trad
  end

  subgraph OURS["本文 RNN-as-MOT (LiDAR-only, end-to-end)"]
    direction LR
    o1["LiDAR scan<br>(+ multi-frame)"]:::obs --> o2["Extractor<br>96D"]:::ext --> o3["<b>RNN hidden h_t (30D)</b><br>implicit belief over<br>obstacle dynamics"]:::rnn
    o3 --> o4["<b>predict_head</b><br>decode motion 13D<br>pos now/future/past + vel"]:::mot
    o4 -.->|aux loss| o5["GT obstacle motion<br>disp_r2 / velocity_r2"]:::aux
    o3 --> o6["Policy"]:::head
    o4 ==>|hybrid skip| o6
  end

  TRAD -.->|"replace the whole module chain<br>with one learned recurrent estimator"| OURS

  classDef trad fill:#ECEFF1,stroke:#546E7A,color:#1c2429;
