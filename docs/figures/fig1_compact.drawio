        <mxCell id="e16" value="obs 79D" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#1565C0;fontColor=#1565C0;fontSize=10;exitX=0.03;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="obsgrp" target="rlin"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="33" y="540"/><mxPoint x="455" y="540"/></Array></mxGeometry></mxCell>
