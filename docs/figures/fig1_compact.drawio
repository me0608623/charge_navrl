<mxfile host="hand">
  <diagram name="fig1_compact">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- group background rects (drawn first = behind) -->
        <mxCell id="obsgrp" value="觀測 Observation 79D (LiDAR-only)" style="rounded=1;fillColor=#F5FAFE;strokeColor=#90CAF9;fontColor=#1565C0;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="28" y="24" width="176" height="248" as="geometry"/></mxCell>
        <mxCell id="extgrp" value="特徵抽取 2-branch Extractor" style="rounded=1;fillColor=#F4FBF5;strokeColor=#A5D6A7;fontColor=#2E7D32;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="236" y="44" width="206" height="204" as="geometry"/></mxCell>

        <!-- Observation inputs -->
        <mxCell id="ego" value="ego 4D&#10;accel · vel · ω · radius" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D2B45;fontSize=11;" vertex="1" parent="1"><mxGeometry x="42" y="52" width="148" height="46" as="geometry"/></mxCell>
        <mxCell id="goal" value="goal 2D&#10;body-frame (x,y)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D2B45;fontSize=11;" vertex="1" parent="1"><mxGeometry x="42" y="104" width="148" height="44" as="geometry"/></mxCell>
        <mxCell id="lidar" value="LiDAR 72D&#10;72 bins @ 5°" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D2B45;fontSize=11;" vertex="1" parent="1"><mxGeometry x="42" y="154" width="148" height="44" as="geometry"/></mxCell>
        <mxCell id="timev" value="time 1D&#10;remaining ratio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D2B45;fontSize=11;" vertex="1" parent="1"><mxGeometry x="42" y="204" width="148" height="44" as="geometry"/></mxCell>

        <!-- Extractor branches -->
        <mxCell id="conv" value="&lt;b&gt;LiDAR branch&lt;/b&gt;&#10;Conv1d ×3 → flatten(1152)&#10;→ Linear(→64) → LN&#10;&lt;b&gt;64D&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#13361b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="180" height="76" as="geometry"/></mxCell>
        <mxCell id="smlp" value="&lt;b&gt;State branch&lt;/b&gt;&#10;(ego+goal+time = 7D)&#10;MLP(7→32→32) → LN&#10;&lt;b&gt;32D&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#13361b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="160" width="180" height="76" as="geometry"/></mxCell>

        <!-- encoder chain top row -->
        <mxCell id="cat96" value="concat&#10;&lt;b&gt;96D&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="128" width="92" height="50" as="geometry"/></mxCell>
        <mxCell id="ff" value="fc_front&#10;Linear(96→48)+ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#3d2400;fontSize=11;" vertex="1" parent="1"><mxGeometry x="612" y="128" width="148" height="50" as="geometry"/></mxCell>
        <mxCell id="rnn" value="&lt;b&gt;RNN&lt;/b&gt; (ReLU, 1 layer)&#10;in 48 → hidden &lt;b&gt;30&lt;/b&gt;&#10;reset on episode done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#3d2400;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="118" width="170" height="72" as="geometry"/></mxCell>

        <!-- decode middle row (folded R→L) -->
        <mxCell id="cat78" value="concat &lt;b&gt;78D&lt;/b&gt;&#10;rnn_out 30 + fc_out 48" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="fm" value="fc_middle&#10;Linear(78→32→12)&#10;preprocess_feat &lt;b&gt;12D&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#3d2400;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="294" width="160" height="68" as="geometry"/></mxCell>
        <mxCell id="ph" value="&lt;b&gt;predict_head&lt;/b&gt;&#10;Linear(12→13)&#10;no activation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#2e0a3d;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="160" height="58" as="geometry"/></mxCell>
        <mxCell id="pred" value="&lt;b&gt;predicted obstacle motion 13D&lt;/b&gt;&#10;now2 · future2 · past2 · dist1 · vel6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontColor=#2e0a3d;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="294" width="190" height="68" as="geometry"/></mxCell>
        <mxCell id="aux" value="Aux loss (log / Huber)&#10;monitors: pos_r2 · disp_r2 · velocity_r2&#10;&lt;i&gt;updates RNN cell&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontColor=#1c2429;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="46" y="398" width="180" height="58" as="geometry"/></mxCell>

        <!-- heads bottom row -->
        <mxCell id="rlin" value="&lt;b&gt;rl_input 104D&lt;/b&gt;&#10;obs 79 ⊕ feat 12 ⊕ pred 13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="210" height="64" as="geometry"/></mxCell>
        <mxCell id="policy" value="&lt;b&gt;Policy Head&lt;/b&gt;&#10;104→256→256→256→512→38&#10;→ 2 × Categorical(19)&#10;&lt;b&gt;MultiDiscrete([19,19])&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#3d0c0e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="570" width="250" height="84" as="geometry"/></mxCell>
        <mxCell id="priv" value="特權 Privileged 50D&#10;10 obstacles × 5D&#10;(rel_x, rel_y, dir, speed, size)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontColor=#3d3500;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="452" width="200" height="58" as="geometry"/></mxCell>
        <mxCell id="value" value="&lt;b&gt;Value Head&lt;/b&gt; (asymmetric)&#10;rl_proj(104→128) ⊕ priv_proj(50→128)&#10;→ merge 256 → MLP → &lt;b&gt;V(s)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#3d0c0e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="566" width="250" height="92" as="geometry"/></mxCell>

        <!-- edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="lidar" target="conv"><mxGeometry relative="1" as="geometry"/></mxCell>
