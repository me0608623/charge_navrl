flowchart LR
  subgraph LID["LiDAR branch (circular Conv1d)"]
    direction TB
    lin["LiDAR input<br>[B, 1, 72]<br>72 bins, circular pad"]:::ext
    c1["Conv1d(1→32, k5, s1, p2)<br>+ ReLU → [B, 32, 72]"]:::ext
    c2["Conv1d(32→64, k5, s2, p2)<br>+ ReLU → [B, 64, 36]"]:::ext
    c3["Conv1d(64→64, k3, s2, p1)<br>+ ReLU → [B, 64, 18]"]:::ext
    fl["flatten → 1152"]:::cat
    lp["Linear(1152→64) + LayerNorm"]:::ext
    lout["<b>LiDAR feature 64D</b>"]:::accent
    lin --> c1 --> c2 --> c3 --> fl --> lp --> lout
  end

  subgraph ST["State branch (MLP)"]
    direction TB
    sin["state input 7D<br>ego4 + goal2 + time1"]:::obs
    s1["Linear(7→32) + ReLU"]:::obs
    s2["Linear(32→32) + ReLU + LN"]:::obs
    sout["<b>State feature 32D</b>"]:::accent
    sin --> s1 --> s2 --> sout
  end

  cat["concat → <b>96D</b><br>(→ fc_front → RNN)"]:::cat
  lout --> cat
  sout --> cat

  mf["multi-frame option<br>--lidar_frame_stack K<br>input → [B, K, 72]<br>Conv1d in-channels = K"]:::aux
  mf -.-> lin

  classDef obs fill:#E3F2FD,stroke:#1565C0,color:#0D2B45;
  classDef ext fill:#E8F5E9,stroke:#2E7D32,color:#13361b;
  classDef accent fill:#FFF3E0,stroke:#E65100,color:#3d2400,stroke-width:2px;
  classDef aux fill:#ECEFF1,stroke:#546E7A,color:#1c2429,stroke-dasharray:5 3;
  classDef cat fill:#FAFAFA,stroke:#9E9E9E,color:#222;